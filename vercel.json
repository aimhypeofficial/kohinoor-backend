{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "crons": [
    { "path": "/api/cron/amc-reminders", "schedule": "0 4 * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 21 * * *" },
    { "path": "/api/cron/db-ping", "schedule": "30 18 * * *" }
  ]
}
