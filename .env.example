# Backend settings. Copy this file to backend/.env for local development (never commit .env).
# Live server: put the same names in Render -> kohinoor-ac-api -> Environment (see DEPLOY.md 3b).
# Keep comments on their own lines. Empty value = feature off.

# Local port for npm run dev (Render sets its own PORT)
PORT=4000

# ---- Supabase (required) ----
SUPABASE_URL=https://xxxx.supabase.co
# Secret key (sb_secret_...). Backend only, never in admin/mobile.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# ---- Email: OTP, service report PDF, AMC reminders ----
# Gmail + App Password: Google Account -> Security -> 2-Step Verification ON -> App passwords
# -> create one -> paste the 16 letters (spaces are fine).
# Both empty = no email; locally the OTP is printed in the backend terminal instead.
SMTP_USER=
SMTP_PASS=
# Other providers (Zoho, Outlook, Hostinger...). Default is Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Sender name customers see. With Gmail the address is always SMTP_USER.
MAIL_FROM=Kohinoor AC <care@kohinoorac.com>
# Alternative to Gmail: Resend API key (kohinoorac.com must be verified in Resend).
# Gmail is used when SMTP_USER + SMTP_PASS are set.
# RESEND_API_KEY=
LOGO_URL=https://www.kohinoorac.com/logo/logo.jpg

# ---- Admin website address(es), comma separated, no trailing slash ----
# Live: https://your-admin.vercel.app  (or * to allow every website)
CORS_ORIGIN=http://localhost:5173

# ---- Push notifications (Firebase project kohinoorrac1) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# -> paste the whole JSON on ONE line. Empty = no push (the app refreshes every 30 s).
FIREBASE_SERVICE_ACCOUNT=

# ---- Daily jobs (AMC reminders, GPS cleanup) ----
# Protects /api/cron/*. Any long random text. Render generates it (render.yaml).
CRON_SECRET=

# ---- Service report PDF after the customer's OTP ----
# auto   = email it immediately (default)
# manual = staff adds the bill on the website, then sends it
REPORT_MODE=auto

# ---- WhatsApp Business Cloud API (optional, DEPLOY.md step 6) ----
# Empty = skip; the website still has one-tap wa.me buttons.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WA_TEMPLATE_LANG=en
WA_TEMPLATE_ACCEPTED=fs_tech_accepted
WA_TEMPLATE_COMPLETED=fs_work_completed
WA_TEMPLATE_REMINDER=fs_amc_reminder
# Completion code on WhatsApp (falls back to email if this template is not approved)
WA_TEMPLATE_OTP=fs_otp

# ---- Render only (ignored locally) ----
# The server pings its own /api/health every 2 min so the free plan never sleeps.
# KEEP_ALIVE=false
# KEEP_ALIVE_MINUTES=2
# Daily jobs run inside the server on Render. RUN_JOBS=false turns them off.
# RUN_JOBS=true
# Requests per minute per client on /api
# RATE_LIMIT_PER_MIN=300